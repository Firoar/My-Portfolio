---
// Fallback page for any route that doesn't exist.
// Vercel serves this (dist/404.html) for every unmatched path, then the
// page bounces the visitor back to the homepage after a short countdown.
import '../styles/global.css';
import { site } from '../data/site';

const host =
  site.name.split(/\s+/)[0].replace(/[^A-Za-z]/g, '').toLowerCase() || 'dev';
const tried = Astro.url.pathname;
const home = '/';
const baseUrl = new URL(site.url);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0a0e14" />
    <meta name="color-scheme" content="dark" />
    <title>404 — route not found · {host}@dev</title>
    <link rel="icon" type="image/svg+xml" href="/pirate.svg" />
  </head>
  <body>
    <main class="nf-wrap">
      <section class="nf-term" aria-label="404 — page not found">
        <header class="nf-bar">
          <span class="nf-lights">
            <i class="nf-light nf-red"></i>
            <i class="nf-light nf-yellow"></i>
            <i class="nf-light nf-green"></i>
          </span>
          <span class="nf-title">{host}@dev: ~/404</span>
        </header>

        <div class="nf-screen">
          <p class="nf-line">
            <span class="nf-prompt">{host}@dev:~$</span>
            curl -s {baseUrl.host}<span class="nf-tried">{tried}</span>
          </p>
          <p class="nf-line nf-err">
            curl: (404) route not found — no such page on this site.
          </p>
          <p class="nf-line nf-info">
            taking you back to <a class="nf-link" href={home}>~</a> in
            <span class="nf-count" id="nf-count">3</span>s …
          </p>
          <p class="nf-line">
            <span class="nf-prompt">{host}@dev:~$</span><span class="nf-cursor"></span>
          </p>
        </div>
      </section>

      <a class="nf-home" href={home}>
        <span class="nf-prompt">→</span> cd ~ &amp; go to the homepage
      </a>
    </main>

    <script>
      // Bounce unknown routes back to the homepage after a short countdown.
      const label = document.getElementById('nf-count');
      let left = 3;
      const tick = setInterval(() => {
        left -= 1;
        if (label) label.textContent = String(Math.max(left, 0));
        if (left <= 0) {
          clearInterval(tick);
          window.location.replace('/');
        }
      }, 1000);
    </script>

    <style>
      .nf-wrap {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 22px;
        padding: 24px;
      }

      .nf-term {
        width: 100%;
        max-width: 640px;
        background: var(--panel);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
      }

      .nf-bar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px;
        background: var(--bg-soft);
        border-bottom: 1px solid var(--line);
      }

      .nf-lights {
        display: inline-flex;
        gap: 6px;
      }

      .nf-light {
        width: 11px;
        height: 11px;
        border-radius: 50%;
      }

      .nf-red {
        background: var(--red);
      }
      .nf-yellow {
        background: var(--yellow);
      }
      .nf-green {
        background: var(--accent);
      }

      .nf-title {
        color: var(--dim);
        font-size: 12.5px;
        letter-spacing: 0.03em;
      }

      .nf-screen {
        padding: clamp(16px, 4vw, 28px);
        font-size: 13.5px;
        line-height: 1.65;
      }

      .nf-line {
        margin: 0 0 3px;
        white-space: pre-wrap;
        word-break: break-word;
      }

      .nf-prompt {
        color: var(--accent);
        margin-right: 10px;
      }

      .nf-tried {
        color: var(--yellow);
      }

      .nf-err {
        color: var(--red);
        margin-top: 10px;
      }

      .nf-info {
        color: var(--muted);
        margin-top: 6px;
      }

      .nf-count {
        color: var(--accent);
        font-weight: 700;
      }

      .nf-cursor {
        display: inline-block;
        width: 8px;
        height: 15px;
        margin-left: 2px;
        vertical-align: -2px;
        background: var(--accent);
        animation: nf-blink 1.1s steps(1) infinite;
      }

      .nf-link {
        color: var(--accent);
        font-weight: 600;
      }

      .nf-home {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 12px 22px;
        border: 1px solid var(--line-strong);
        border-radius: var(--radius);
        color: var(--text);
        background: var(--bg-elev);
        transition: border-color 0.2s ease, color 0.2s ease;
      }

      .nf-home:hover {
        border-color: var(--accent);
        color: var(--accent);
        text-decoration: none;
      }

      .nf-home .nf-prompt {
        margin-right: 0;
      }

      @keyframes nf-blink {
        0%,
        55% {
          opacity: 1;
        }
        56%,
        100% {
          opacity: 0;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nf-cursor {
          animation: none;
        }
      }
    </style>
  </body>
</html>