---
import BaseLayout from "../layouts/BaseLayout.astro";
import SkillIcon from "../components/SkillIcon.astro";
import VisitorCounter from "../components/VisitorCounter.astro";
import { profile, socials, contactBlurb, skillGroups, projects, experience, analytics } from "../data/profile";
---

<BaseLayout>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      {
        profile.avatar && (
          <img class="hero-avatar" src={profile.avatar} alt={`Photo of ${profile.name}`} />
        )
      }
      <h1>{profile.name}</h1>
      <p class="hero-role">{profile.role}</p>
      <p class="hero-tagline">{profile.tagline}</p>
      <div class="hero-actions">
        {
          profile.resumeUrl && (
            <a class="btn btn-primary" href={profile.resumeUrl} target="_blank" rel="noopener noreferrer">
              Résumé
            </a>
          )
        }
        <a class="btn" href="#projects">View projects</a>
      </div>
    </div>
  </section>

  <!-- About -->
  <section class="section" id="about">
    <div class="container">
      <h2 class="section-title">About</h2>
      <div class="about-text">
        <p>{profile.bio}</p>
        {
          profile.facts.length > 0 && (
            <ul class="about-facts">
              {profile.facts.map((fact) => <li>{fact}</li>)}
            </ul>
          )
        }
        <p>📍 {profile.location} · <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
      </div>
    </div>
  </section>

  <!-- Skills -->
  {
    skillGroups.length > 0 && (
      <section class="section section-alt" id="skills">
        <div class="container">
          <h2 class="section-title">Skills</h2>
          <div class="skills-grid">
            {skillGroups.map((group) => (
              <div class="skill-group">
                <h3>{group.title}</h3>
                <ul>
                  {group.items.map((item) => (
                    <li><SkillIcon skill={item} />{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Projects -->
  {
    projects.length > 0 && (
      <section class="section" id="projects">
        <div class="container">
          <h2 class="section-title">Projects</h2>
          <div class="projects-grid">
            {projects.map((project) => (
              <article class="project-card">
                <h3>{project.name}</h3>
                <p>{project.description}</p>
                <div class="project-tech">
                  {project.tech.map((t) => <span>{t}</span>)}
                </div>
                <div class="project-links">
                  {project.url && <a href={project.url} target="_blank" rel="noopener noreferrer">Live site ↗</a>}
                  {project.repo && <a href={project.repo} target="_blank" rel="noopener noreferrer">Source ↗</a>}
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Experience -->
  {
    experience.length > 0 && (
      <section class="section section-alt" id="experience">
        <div class="container">
          <h2 class="section-title">Experience</h2>
          <div class="timeline">
            {experience.map((job) => (
              <div class="timeline-item">
                <h3>{job.role} at {job.company}</h3>
                <p class="meta">{job.period}</p>
                {
                  Array.isArray(job.description) ? (
                    <ul class="timeline-bullets">
                      {job.description.map((point) => <li>{point}</li>)}
                    </ul>
                  ) : (
                    <p>{job.description}</p>
                  )
                }
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Contact -->
  <section class="section contact" id="contact">
    <div class="container" style="text-align: center;">
      <h2 class="section-title">Contact</h2>
      <p>{contactBlurb}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>Email me</a>
        {socials.map((s) => (
          <a class="btn" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>
        ))}
      </div>
      {analytics.goatcounter && <VisitorCounter />}
    </div>
  </section>
</BaseLayout>
