---
import { stackIcon } from '../data/icons';

interface Props {
  name: string;
  size?: number;
}

const { name, size = 16 } = Astro.props;
const icon = stackIcon(name);
---

{icon ? (
  <svg
    class="tech-icon"
    width={size}
    height={size}
    viewBox="0 0 24 24"
    role="img"
    aria-label={name}
  >
    <path d={icon.path} fill={`#${icon.hex}`} />
  </svg>
) : (
  <span class="tech-icon tech-icon--fallback" aria-hidden="true">›</span>
)}
