---
// An interactive command-line terminal — visitors type commands, get responses.
// Every response is driven by the site data files, injected at build time.
import { getCollection } from 'astro:content';
import { site, about, skills, experience, contact } from '../data/site';

const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    title: p.data.title,
    status: p.data.status,
    stack: p.data.stack,
    description: p.data.description,
    demo: p.data.demo,
    repo: p.data.repo,
  }));

// Short hostname for the prompt + window title, e.g. "chiranjivi@dev"
const host =
  site.name.split(/\s+/)[0].replace(/[^A-Za-z]/g, '').toLowerCase() || 'dev';
---

<div class="term interactive-term reveal" id="inter-term">
  <div class="term-bar">
    <span class="lights">
      <i class="light red"></i>
      <i class="light yellow"></i>
      <i class="light green"></i>
    </span>
    <span class="title">{host}@dev: ~</span>
  </div>

  <div class="term-screen" id="screen" role="log" aria-live="polite"></div>

  <form class="term-prompt" id="prompt" autocomplete="off">
    <label for="cmd-input" class="prompt-label">{host}@dev:~$</label>
    <input
      id="cmd-input"
      type="text"
      name="cmd"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      aria-label="Type a command"
      placeholder="type a command, or «help»"
    />
  </form>
</div>

<style is:global>
  .interactive-term {
    display: flex;
    flex-direction: column;
    max-width: 720px;
    max-height: 460px;
    margin-bottom: 8px;
  }

  .term-screen {
    flex: 1;
    overflow-y: auto;
    padding: clamp(14px, 3vw, 24px);
    font-size: 13.5px;
    line-height: 1.65;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
    overscroll-behavior: contain;
  }

  .term-screen::-webkit-scrollbar {
    width: 8px;
  }
  .term-screen::-webkit-scrollbar-thumb {
    background: var(--line-strong);
    border-radius: 4px;
  }

  .term-screen p {
    margin: 0 0 3px;
    white-space: pre-wrap;
    word-break: break-word;
  }

  /* --- output line types --- */
  .out.head {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 12px;
    margin: 16px 0 8px;
    padding-bottom: 5px;
    border-bottom: 1px dashed var(--line);
  }

  .out.dim {
    color: var(--dim);
  }
  .out.muted {
    color: var(--muted);
  }
  .out.acc {
    color: var(--accent);
    font-weight: 600;
  }
  .out.err {
    color: var(--red);
  }
  .out.ok {
    color: var(--accent);
  }

  .out.kv {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 1px 0;
  }
  .out.kv .k {
    color: var(--dim);
    min-width: 108px;
    flex-shrink: 0;
  }
  .out.kv .v {
    color: var(--text);
  }

  .out.bullet::before {
    content: '↳ ';
    color: var(--dim);
  }

  /* --- project card + logo --- */
  .out.project {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    margin: 6px 0 0;
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 8px;
    background: var(--bg-elev);
  }
  .out.project .nm {
    color: var(--accent);
    font-weight: 700;
  }
  .out.project .st {
    font-size: 10.5px;
    padding: 1px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
  }
  .out.project .st.active {
    color: var(--accent);
  }
  .out.project .st.in-progress {
    color: var(--yellow);
  }
  .out.project .st.archived {
    color: var(--red);
  }
  .out.project .ds {
    flex-basis: 100%;
    color: var(--muted);
    font-size: 12.5px;
  }

  /* the command you typed is shown on a solid green highlighted bar so it
     can never be mistaken for the plain output around it */
  .echo {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin: 18px 0 10px !important;
    padding: 7px 12px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--accent-ink);
  }
  .echo .p {
    color: var(--accent-ink);
    opacity: 0.72;
    font-weight: 700;
    white-space: nowrap;
  }
  .echo .typed {
    color: var(--accent-ink);
    font-weight: 700;
  }

  /* help: aligned two-column command list (command : description) */
  .out.cmd {
    display: flex;
    gap: 10px;
    align-items: baseline;
    padding: 2px 0 2px 10px;
  }
  .out.cmd .c {
    color: var(--accent);
    font-weight: 600;
    min-width: 112px;
    flex-shrink: 0;
  }
  .out.cmd .c::before {
    content: '>';
    color: var(--dim);
    display: inline-block;
    width: 7px;
    margin-right: 8px;
  }
  .out.cmd .c::after {
    content: ':';
    color: var(--dim);
  }
  .out.cmd .d {
    color: var(--muted);
  }

  .term-prompt {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 12px 16px;
    border-top: 1px solid var(--line);
    background: var(--bg-elev);
  }

  .prompt-label {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
  }

  .term-prompt input {
    flex: 1;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13.5px;
    caret-color: var(--accent);
  }

  .term-prompt input::placeholder {
    color: var(--dim);
  }

  .term-prompt:focus-within {
    box-shadow: inset 0 1px 0 var(--line-strong);
  }

  @media (max-width: 640px) {
    .interactive-term {
      max-height: 360px;
    }
  }
</style>


<script define:vars={{ site, about, skills, experience, contact, projects }}>
  const input = document.getElementById('cmd-input');
  const screen = document.getElementById('screen');
  const form = document.getElementById('prompt');
  const term = document.getElementById('inter-term');
  if (!input || !screen || !form || !term) throw new Error('terminal missing');

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const host = site.name.split(/\s+/)[0].replace(/[^A-Za-z]/g, '').toLowerCase() || 'dev';
  const history = [];
  let histIndex = 0;

  // ---- DOM helpers (textContent only → XSS-safe) ----
  const add = (cls, text) => {
    const p = document.createElement('p');
    p.className = cls;
    p.textContent = text;
    screen.append(p);
    return p;
  };
  const kv = (k, v) => {
    const p = document.createElement('p');
    p.className = 'out kv';
    const a = document.createElement('span');
    a.className = 'k';
    a.textContent = k;
    const b = document.createElement('span');
    b.className = 'v';
    b.textContent = v;
    p.append(a, b);
    screen.append(p);
  };
  const cmd = (k, v) => {
    const p = document.createElement('p');
    p.className = 'out cmd';
    const a = document.createElement('span');
    a.className = 'c';
    a.textContent = k;
    const b = document.createElement('span');
    b.className = 'd';
    b.textContent = v;
    p.append(a, b);
    screen.append(p);
  };
  const scrollDown = () => {
    screen.scrollTop = screen.scrollHeight;
  };

  // ---- commands ----
  const COMMANDS = {
    help() {
      add('out head', 'Commands');
      [
        ['help', 'show this help'],
        ['whoami', 'who I am'],
        ['about', 'what I do'],
        ['stack', 'tech stack'],
        ['projects', 'my work'],
        ['experience', 'work history'],
        ['education', 'academics'],
        ['achievements', 'highlights'],
        ['contact', 'how to reach me'],
        ['resume', 'view my résumé'],
        ['socials', 'links'],
        ['echo <text>', 'repeat text'],
        ['clear', 'clear the screen'],
      ].forEach(([k, v]) => cmd(k, v));
      add('out dim', '— tip: press Tab to autocomplete · ↑/↓ for history');
    },
    whoamiCore(head) {
      add('out head', head);
      kv('name', site.name);
      kv('role', site.role);
      kv('tagline', site.tagline);
      kv('location', site.location);
      kv('status', 'open to internships & full-time');
    },
    whoami() {
      this.whoamiCore('Whoami');
    },
    about() {
      this.whoamiCore('About');
    },
    stack() {
      add('out head', 'Tech stack');
      Object.entries(skills).forEach(([k, arr]) => kv(k, arr.join(', ')));
    },
    projects() {
      add('out head', 'Projects');
      projects.forEach((p) => {
        const card = document.createElement('p');
        card.className = 'out project';
        const nm = document.createElement('span');
        nm.className = 'nm';
        nm.textContent = './' + p.title;
        const st = document.createElement('span');
        st.className = 'st ' + p.status;
        st.textContent = p.status;
        const ds = document.createElement('span');
        ds.className = 'ds';
        ds.textContent = p.description;
        card.append(nm, st, ds);
        screen.append(card);
      });
    },
    experience() {
      add('out head', 'Experience');
      experience.forEach((j) => {
        add('out acc', `${j.role} · ${j.company}`);
        add('out dim', `[${j.period}]`);
        j.notes.forEach((n) => add('out bullet', n));
      });
    },

    education() {
      add('out head', 'Education');
      kv('degree', 'B.Tech, Computer Science');
      kv('institute', 'IIIT Kottayam');
      kv('period', 'Nov 2022 — Apr 2026');
      kv('cgpa', '8.50 / 10');
    },
    achievements() {
      add('out head', 'Achievements');
      add('out bullet', '1000+ problems solved on Codeforces, LeetCode & GeeksforGeeks');
      add('out bullet', 'Pupil on Codeforces');
    },
    contact() {
      add('out head', 'Contact');
      kv('email', contact.email);
      kv('github', contact.github);
      kv('linkedin', contact.linkedin);
      add('out ok', '✓ usually replies within a day');
    },
    resume() {
      add('out head', 'Resume');
      const p = document.createElement('p');
      p.className = 'out';
      const a = document.createElement('a');
      a.textContent = 'open résumé ↗';
      a.href = site.resume;
      a.target = '_blank';
      a.rel = 'noopener';
      p.append(a);
      screen.append(p);
      add('out dim', 'My full résumé — experience, projects & education.');
    },
    socials() {
      add('out head', 'Socials');
      contact.socials.forEach((s) => kv(s.label, s.url));
    },
  };

  const ALIASES = { skills: 'stack', ls: 'projects', '?': 'help' };

  const run = (raw) => {
    const argv = raw.trim().split(/\s+/);
    const first = (argv[0] || '').toLowerCase();
    const rest = raw.trim().slice((argv[0] || '').length).trim();

    if (first === 'clear') {
      screen.innerHTML = '';
      return;
    }
    if (first === 'echo') {
      add('out', rest || '');
      add('out dim', '');
      return;
    }
    const fn = COMMANDS[ALIASES[first] || first];
    if (!fn) {
      add('out err', `command not found: ${first} — try "help"`);
    } else {
      fn();
    }
    // blank line after every command's output → separates command blocks
    add('out dim', '');
  };

  // typed echo for a little life
  const typeEcho = async (text) => {
    const p = document.createElement('p');
    p.className = 'echo';
    const pr = document.createElement('span');
    pr.className = 'p';
    pr.textContent = `${host}@dev:~$`;
    const tx = document.createElement('span');
    tx.className = 'typed';
    tx.textContent = '';
    p.append(pr, tx);
    screen.append(p);
    if (reduce) {
      tx.textContent = text;
      return;
    }
    for (let i = 0; i <= text.length; i++) {
      tx.textContent = text.slice(0, i);
      scrollDown();
      await new Promise((r) => setTimeout(r, 11));
    }
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const val = input.value;
    if (val.trim()) history.push(val);
    histIndex = history.length;
    input.value = '';
    await typeEcho(val);
    if (val.trim()) run(val);
    scrollDown();
  });

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (histIndex > 0) {
        histIndex -= 1;
        input.value = history[histIndex] || '';
      }
    } else if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (histIndex < history.length) {
        histIndex += 1;
        input.value = history[histIndex] || '';
      }
    } else if (e.key === 'Tab') {
      e.preventDefault();
      const word = (input.value.split(/\s+/).pop() || '').toLowerCase();
      const names = Object.keys(COMMANDS).concat(Object.keys(ALIASES));
      const match = names.find((n) => n.startsWith(word));
      if (match && word) {
        input.value = input.value.slice(0, -word.length) + match + ' ';
      }
    }
  });

  // focus behaviour
  const focusInput = () => input.focus();
  term.addEventListener('click', (e) => {
    if (e.target !== input) focusInput();
  });
  if (!window.matchMedia('(pointer: coarse)').matches) focusInput();

  // boot banner
  (function boot() {
    add('out acc', `${site.name} — ${site.role}`);
    add('out dim', '─────────────────────────────────────');
    add('out muted', 'Type "help" for commands · "projects" for my work · press Tab to autocomplete.');
    add('out dim', '');
  })();
  scrollDown();
</script>

