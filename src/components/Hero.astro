---
import { site } from '../data/site';
import Terminal from './Terminal.astro';

const host = site.name.split(/\s+/)[0].replace(/[^A-Za-z]/g, '').toLowerCase();
---

<section class="hero" id="top">
  <div class="container">
    <p class="kicker reveal">~/{host} — interactive résumé</p>

    <h1 class="reveal">
      Hello, I'm <span class="accent">{site.name}</span>.<br />
      I am the best in the world.
    </h1>

    <p class="sub reveal">{site.tagline}</p>

    <div class="cta-row reveal">
      <a class="btn primary" href="#projects">
        <span class="prompt">$</span> view projects
      </a>
      <a class="btn" href={site.resume} target="_blank" rel="noopener">
        <span class="prompt">→</span> résumé
      </a>
      <a class="btn" href="#contact">
        <span class="prompt">></span> get in touch
      </a>
    </div>

    <!-- Interactive terminal — visitors can type commands -->
    <Terminal />

    <p class="visually-hidden">
      {site.name}, {site.role}. {site.description}
    </p>

    <div class="hero-meta reveal">
      <span>
        <span class="val">status</span> · open to work
      </span>
      <span>
        <span class="val">problems</span> · 1000+ solved
      </span>
      <span>
        <span class="val">location</span> · {site.location}
      </span>
    </div>
  </div>
</section>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
