---
import { experience } from '../data/site';
---

<section class="section" id="experience">
  <div class="container">
    <div class="section-head reveal">
      <span class="num">04.</span>
      <h2>tail -f experience.log</h2>
      <span class="rule"></span>
    </div>

    <ol class="exp-list">
      {experience.map((job) => (
        <li class="exp-item reveal">
          <p class="exp-period">[{job.period}]</p>
          <p class="exp-role">
            {job.role} <span class="exp-company">@ {job.company}</span>
          </p>
          <ul class="exp-notes">
            {job.notes.map((note) => (
              <li>{note}</li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>
